# Copy to .env and adjust. Every variable has the NETOPS_ prefix.

NETOPS_DATABASE_URL=postgresql+psycopg://netops:netops@localhost:5432/netops
NETOPS_REDIS_URL=redis://localhost:6379/0

# Checkout of the intent Git repository (inventory.yaml + devices/<hostname>.yaml)
NETOPS_INTENT_REPO_PATH=../intent
# Jinja2 templates: <path>/<platform>/{base,interfaces,acls,bgp}.j2
NETOPS_TEMPLATES_PATH=../templates
# Optional extra normalization rules (see netops/network/normalization.py)
# NETOPS_NORMALIZATION_RULES_PATH=../normalization.yaml

# "offline" reads running-configs from <NETOPS_OFFLINE_LAB_PATH>/<hostname>.cfg
NETOPS_NETWORK_DRIVER=offline
NETOPS_OFFLINE_LAB_PATH=../lab/running

NETOPS_COMMIT_CONFIRM_TIMEOUT_SECONDS=180
NETOPS_MAX_PING_LOSS_PERCENT=20
# Post-check retries while BGP converges (at most half of the confirm timer)
NETOPS_POST_CHECK_ATTEMPTS=6
NETOPS_POST_CHECK_INTERVAL_SECONDS=10
NETOPS_DRIFT_SCAN_INTERVAL_SECONDS=900
NETOPS_JOB_TIMEOUT_SECONDS=3600

# Bootstrap API tokens -> users and roles (viewer | operator | admin). Development values only!
# Further users are created by an admin through POST /api/v1/users.
NETOPS_API_TOKENS='{"dev-admin-token": {"username": "admin", "role": "admin"}, "dev-operator-token": {"username": "operator", "role": "operator"}, "dev-viewer-token": {"username": "viewer", "role": "viewer"}}'

# SSH credentials referenced by Device.auth_profile
NETOPS_AUTH_PROFILES='{"lab": {"username": "admin", "password": "admin"}}'

# Browser origins of the web UI
NETOPS_CORS_ORIGINS='["http://localhost:5173"]'

# LLM Risk Assistant (Xiaomi MiMo-V2.6-Flash or any OpenAI-compatible provider)
# NETOPS_LLM_API_KEY=sk-...
# NETOPS_LLM_BASE_URL=https://api.hcnsec.cn/v1
# NETOPS_LLM_MODEL=MiMo-V2.6-Flash

# Forecasting: run the local TimesFM service (needs a Python with 	imesfm + torch):
#   python backend/tools/timesfm_server.py --model <local dir or google/timesfm-3.0-pytorch>
# Without it the API falls back to a statistical trend. Empty value disables the remote call.
# NETOPS_FORECAST_URL=http://127.0.0.1:8100/forecast

# NetBox as inventory source for POST /api/v1/inventory/sync (default: inventory.yaml)
# NETOPS_NETBOX_URL=https://netbox.example.com
# NETOPS_NETBOX_TOKEN=...
