# Скопировать в .env и поправить. Все переменные с префиксом NETOPS_.

NETOPS_DATABASE_URL=postgresql+psycopg://netops:netops@localhost:5432/netops
NETOPS_REDIS_URL=redis://localhost:6379/0

# Рабочая копия репозитория intent (inventory.yaml + devices/<hostname>.yaml)
NETOPS_INTENT_REPO_PATH=../intent
# Шаблоны Jinja2: <путь>/<платформа>/{base,interfaces,acls,bgp}.j2
NETOPS_TEMPLATES_PATH=../templates
# Свой файл фильтров диффа в формате netops/network/diff_filters.yaml (необязательно)
# NETOPS_DIFF_FILTERS_PATH=../diff_filters.yaml

# offline — стенд на файлах <NETOPS_OFFLINE_LAB_PATH>/<hostname>.cfg
NETOPS_NETWORK_DRIVER=offline
NETOPS_OFFLINE_LAB_PATH=../lab/running

NETOPS_COMMIT_CONFIRM_TIMEOUT_SECONDS=180
NETOPS_MAX_PING_LOSS_PERCENT=20
# Повторы post-check, пока сходится BGP (не больше половины таймера commit confirmed)
NETOPS_POST_CHECK_ATTEMPTS=6
NETOPS_POST_CHECK_INTERVAL_SECONDS=10
NETOPS_DRIFT_SCAN_INTERVAL_SECONDS=900
# Период сбора метрик воркером и срок хранения замеров в базе
NETOPS_METRICS_INTERVAL_SECONDS=60
NETOPS_METRICS_RETENTION_DAYS=7
NETOPS_JOB_TIMEOUT_SECONDS=3600

# Начальные токены API: пользователь и роль (viewer | operator | admin). Только для разработки!
# Остальных пользователей админ заводит через POST /api/v1/users.
NETOPS_API_TOKENS='{"dev-owner-token": {"username": "owner", "role": "admin"}, "dev-admin-token": {"username": "admin", "role": "admin"}, "dev-operator-token": {"username": "operator", "role": "operator"}, "dev-viewer-token": {"username": "viewer", "role": "viewer"}}'

# SSH-учётки для auth_profile из intent/inventory.yaml. Здесь заглушки, реальные пароли
# стенда — только в своём backend/.env, в Git их не коммитим.
NETOPS_AUTH_PROFILES='{"lab": {"username": "admin", "password": "admin"}, "spine1_auth": {"username": "admin", "password": "admin"}, "spine2_auth": {"username": "admin", "password": "admin"}, "leaf1_auth": {"username": "admin", "password": "admin"}, "leaf2_auth": {"username": "admin", "password": "admin"}}'

# Телеграм-бот метрик: токен от @BotFather и чаты, которым бот отвечает и шлёт оповещения.
# Без них контейнер telegram-bot простаивает.
# NETOPS_TELEGRAM_BOT_TOKEN=123456789:AA...
# NETOPS_TELEGRAM_CHAT_IDS='[123456789]'

# Адреса веб-интерфейса, которым разрешены запросы из браузера
NETOPS_CORS_ORIGINS='["http://localhost:5173"]'

# ИИ-ассистент (копилот и пояснение диффа). Провайдеры опрашиваются по очереди, первый
# ответивший выигрывает. Без ключей работает резервный режим на правилах.
# NETOPS_OLLAMA_URL=http://localhost:11434/v1   # локальная модель, ключ не нужен
# NETOPS_GROQ_API_KEY=gsk_...
# NETOPS_GEMINI_API_KEY=...
# NETOPS_LLM_API_KEY=sk-...
# NETOPS_LLM_BASE_URL=https://api.hcnsec.cn/v1
# NETOPS_LLM_MODEL=MiMo-V2.6-Flash

# Исторические метрики для прогноза и сервис прогноза (tools/timesfm_server.py)
# NETOPS_PROMETHEUS_URL=http://prometheus:9090
# NETOPS_FORECAST_URL=http://forecast:8077/forecast
