{% for acl in intent.acls %}
ip access-list extended {{ acl.name }}
{% for rule in acl.rules %}
{% if rule.dst_port is defined and rule.dst_port %}
  rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} any any eq {{ rule.dst_port }}
{% elif rule.src_port is defined and rule.src_port %}
  rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} any eq {{ rule.src_port }} any
{% else %}
  rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} any any
{% endif %}
{% endfor %}
exit
{% endfor %}
