{% if intent.bgp %}
router bgp {{ intent.bgp.asn }}
  router-id {{ intent.bgp.router_id }}
{% for neighbor in intent.bgp.neighbors %}
  neighbor {{ neighbor.peer_ip }}
    remote-as {{ neighbor.remote_asn }}
{% if neighbor.description %}
    description "{{ neighbor.description }}"
{% endif %}
    enable
  exit
{% endfor %}
  address-family ipv4 unicast
{% set prefixes = intent.bgp.neighbors | map(attribute="announced_prefixes") | sum(start=[]) | unique | list %}
{% if prefixes %}
{% for prefix in prefixes %}
    network {{ prefix.network_address }}/{{ prefix.prefixlen if prefix.prefixlen is defined else 32 }}
{% endfor %}
{% else %}
    network {{ intent.bgp.router_id }}/32
{% endif %}
  exit
exit
{% endif %}
