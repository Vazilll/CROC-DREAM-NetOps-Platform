{% if intent.bgp %}
router bgp {{ intent.bgp.asn }}
 bgp router-id {{ intent.bgp.router_id }}
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
{% for neighbor in intent.bgp.neighbors %}
 neighbor {{ neighbor.peer_ip }} remote-as {{ neighbor.remote_asn }}
{% if neighbor.description %}
 neighbor {{ neighbor.peer_ip }} description {{ neighbor.description }}
{% endif %}
{% if neighbor.password %}
 neighbor {{ neighbor.peer_ip }} password {{ neighbor.password }}
{% endif %}
{% endfor %}
 !
 address-family ipv4
{% set prefixes = intent.bgp.neighbors | map(attribute="announced_prefixes") | sum(start=[]) | unique | list %}
{% if prefixes %}
{% for prefix in prefixes %}
  network {{ prefix.network_address }} mask {{ prefix.netmask }}
{% endfor %}
{% else %}
  network {{ intent.bgp.router_id }} mask 255.255.255.255
{% endif %}
{% for neighbor in intent.bgp.neighbors %}
  neighbor {{ neighbor.peer_ip }} activate
{% endfor %}
 exit-address-family
{% if intent.bgp.evpn %}
 !
 address-family l2vpn evpn
{% for neighbor in intent.bgp.neighbors %}
  neighbor {{ neighbor.peer_ip }} activate
  neighbor {{ neighbor.peer_ip }} send-community both
  neighbor {{ neighbor.peer_ip }} next-hop-unchanged
{% endfor %}
 exit-address-family
{% endif %}
{% endif %}
