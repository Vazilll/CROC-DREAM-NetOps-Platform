{% raw %}
router bgp 65000
 bgp router-id 10.255.0.11
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.10.0.1 remote-as 65001
 neighbor 10.10.0.1 description leaf-1
 neighbor 10.10.0.3 remote-as 65002
 neighbor 10.10.0.3 description leaf-2
 !
 address-family ipv4
  network 10.255.0.11 mask 255.255.255.255
  neighbor 10.10.0.1 activate
  neighbor 10.10.0.3 activate
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor 10.10.0.1 activate
  neighbor 10.10.0.1 send-community both
  neighbor 10.10.0.1 next-hop-unchanged
  neighbor 10.10.0.3 activate
  neighbor 10.10.0.3 send-community both
  neighbor 10.10.0.3 next-hop-unchanged
 exit-address-family
!
{% endraw %}
