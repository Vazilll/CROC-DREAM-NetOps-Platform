{% raw %}
interface GigabitEthernet1
 description Management interface
 vrf forwarding clab-mgmt
 ip address 10.0.0.15 255.255.255.0
 no shutdown
 negotiation auto
!
interface Loopback0
 description Router-ID / BGP announce
 ip address 10.255.0.11 255.255.255.255
!
interface GigabitEthernet2
 description Downlink to leaf1 GE1/0/0
 ip address 10.10.0.0 255.255.255.254
 ip access-group FABRIC-IN in
 no shutdown
 negotiation auto
!
interface GigabitEthernet3
 description Downlink to leaf2 GE1/0/0
 ip address 10.10.0.2 255.255.255.254
 ip access-group FABRIC-IN in
 no shutdown
 negotiation auto
!
{% endraw %}
