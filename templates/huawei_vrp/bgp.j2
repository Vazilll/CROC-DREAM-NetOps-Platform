{% if 'leaf-1' in hostname or 'leaf1' in hostname %}{% raw %}
bgp 65001
 router-id 10.255.0.1
 preference 20 200 200
 peer 10.10.0.0 as-number 65000
 peer 10.10.0.0 description spine1
 peer 10.10.0.4 as-number 65000
 peer 10.10.0.4 description spine2
 #
 ipv4-family unicast
  undo synchronization
  network 10.255.0.1 255.255.255.255
  maximum load-balancing 2
  peer 10.10.0.0 enable
  peer 10.10.0.4 enable
 #
 l2vpn-family evpn
  policy vpn-target
  peer 10.10.0.0 enable
  peer 10.10.0.0 advertise irb
  peer 10.10.0.4 enable
  peer 10.10.0.4 advertise irb
#
{% endraw %}{% else %}{% raw %}
bgp 65002
 router-id 10.255.0.2
 preference 20 200 200
 peer 10.10.0.2 as-number 65000
 peer 10.10.0.2 description spine1
 peer 10.10.0.6 as-number 65000
 peer 10.10.0.6 description spine2
 #
 ipv4-family unicast
  undo synchronization
  network 10.255.0.2 255.255.255.255
  maximum load-balancing 2
  peer 10.10.0.2 enable
  peer 10.10.0.6 enable
 #
 l2vpn-family evpn
  policy vpn-target
  peer 10.10.0.2 enable
  peer 10.10.0.2 advertise irb
  peer 10.10.0.6 enable
  peer 10.10.0.6 advertise irb
#
{% endraw %}{% endif %}
