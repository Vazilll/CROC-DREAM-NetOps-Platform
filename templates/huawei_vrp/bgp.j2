{% if intent.bgp %}
bgp {{ intent.bgp.asn }}
 router-id {{ intent.bgp.router_id }}
 preference 20 200 200
{% for neighbor in intent.bgp.neighbors %}
 peer {{ neighbor.peer_ip }} as-number {{ neighbor.remote_asn }}
{% if neighbor.description %}
 peer {{ neighbor.peer_ip }} description {{ neighbor.description }}
{% endif %}
{% if neighbor.password %}
 peer {{ neighbor.peer_ip }} password cipher {{ neighbor.password }}
{% endif %}
{% endfor %}
 #
 ipv4-family unicast
  undo synchronization
{% set prefixes = intent.bgp.neighbors | map(attribute="announced_prefixes") | sum(start=[]) | unique | list %}
{% if prefixes %}
{% for prefix in prefixes %}
  network {{ prefix.network_address }} {{ prefix.netmask }}
{% endfor %}
{% else %}
  network {{ intent.bgp.router_id }} 255.255.255.255
{% endif %}
  maximum load-balancing 2
{% for neighbor in intent.bgp.neighbors %}
  peer {{ neighbor.peer_ip }} enable
{% endfor %}
 #
 l2vpn-family evpn
  policy vpn-target
{% for neighbor in intent.bgp.neighbors %}
  peer {{ neighbor.peer_ip }} enable
  peer {{ neighbor.peer_ip }} advertise irb
{% endfor %}
#
ospf 1 router-id {{ intent.bgp.router_id }}
 area 0.0.0.0
  network {{ intent.bgp.router_id }} 0.0.0.0
{% for iface in intent.interfaces %}
{% if iface.ipv4_address and not iface.name.lower().startswith("loopback") and iface.acl_in %}
{% set net_addr = iface.ipv4_address.network.network_address if iface.ipv4_address.network is defined else iface.ipv4_address.network_address %}
  network {{ net_addr }} 0.0.0.1
{% endif %}
{% endfor %}
#
{% endif %}
