{% if 'leaf-1' in hostname or 'leaf1' in hostname %}{% raw %}
interface MEth0/0/0
 undo shutdown
 ip binding vpn-instance __MGMT_VPN__
 ip address 10.0.0.15 255.255.255.0
#
interface LoopBack0
 description Router-ID / BGP announce / VTEP source
 ip address 10.255.0.1 255.255.255.255
#
interface GE1/0/0
 description Uplink to spine1 GigabitEthernet2
 undo portswitch
 undo shutdown
 ip address 10.10.0.1 255.255.255.254
 traffic-filter inbound acl name FABRIC-IN
#
interface GE1/0/1
 description Uplink to spine2 Ethernet1
 undo portswitch
 undo shutdown
 ip address 10.10.0.5 255.255.255.254
 traffic-filter inbound acl name FABRIC-IN
#
interface GE1/0/9
 description Access to host-a (VLAN 10)
 undo shutdown
 port link-type access
 port default vlan 10
#
interface Vbdif10
 description Anycast gateway VLAN10 10.20.1.0/24
 ip address 10.20.1.1 255.255.255.0
 arp distribute-gateway enable
#
interface Nve1
 description VXLAN VTEP
 source 10.255.0.1
 vni 10010 head-end peer-list protocol bgp
#
{% endraw %}{% else %}{% raw %}
interface MEth0/0/0
 undo shutdown
 ip binding vpn-instance __MGMT_VPN__
 ip address 10.0.0.15 255.255.255.0
#
interface LoopBack0
 description Router-ID / BGP announce / VTEP source
 ip address 10.255.0.2 255.255.255.255
#
interface GE1/0/0
 description Uplink to spine1 GigabitEthernet3
 undo portswitch
 undo shutdown
 ip address 10.10.0.3 255.255.255.254
 traffic-filter inbound acl name FABRIC-IN
#
interface GE1/0/1
 description Uplink to spine2 Ethernet2
 undo portswitch
 undo shutdown
 ip address 10.10.0.7 255.255.255.254
 traffic-filter inbound acl name FABRIC-IN
#
interface GE1/0/9
 description Access to host-b (VLAN 10)
 undo shutdown
 port link-type access
 port default vlan 10
#
interface Vbdif10
 description Anycast gateway VLAN10 10.20.1.0/24
 ip address 10.20.1.1 255.255.255.0
 arp distribute-gateway enable
#
interface Nve1
 description VXLAN VTEP
 source 10.255.0.2
 vni 10010 head-end peer-list protocol bgp
#
{% endraw %}{% endif %}
