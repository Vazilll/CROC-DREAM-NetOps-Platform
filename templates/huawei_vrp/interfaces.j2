{% for iface in intent.interfaces %}
interface {{ iface.name }}
{% if not iface.name.lower().startswith("loopback") and iface.name != "GE1/0/9" %}
 undo portswitch
{% endif %}
{% if iface.description %}
 description {{ iface.description }}
{% endif %}
{% if iface.name == "GE1/0/9" %}
 port link-type access
 port default vlan 10
{% endif %}
{% if iface.ipv4_address and iface.name != "GE1/0/9" %}
 ip address {{ iface.ipv4_address.ip }} {{ iface.ipv4_address.netmask }}
{% endif %}
{% if iface.acl_in %}
 traffic-filter inbound acl name {{ iface.acl_in }}
 ospf network-type p2p
{% endif %}
{% if not iface.name.lower().startswith("loopback") %}
{% if iface.enabled %}
 undo shutdown
{% else %}
 shutdown
{% endif %}
{% endif %}
{% endfor %}
interface Vbdif10
 description Anycast gateway VLAN10 10.20.1.0/24
 ip address 10.20.1.1 255.255.255.0
 arp distribute-gateway enable
#
interface Nve1
 description VXLAN VTEP
 source {{ intent.bgp.router_id if intent.bgp else '10.255.0.1' }}
 vni 10010 head-end peer-list protocol bgp
