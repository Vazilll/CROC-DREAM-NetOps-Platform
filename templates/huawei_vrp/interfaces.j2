{% for iface in intent.interfaces %}
interface {{ iface.name }}
{% if not iface.name.lower().startswith("loopback") %}
 undo portswitch
{% endif %}
{% if iface.description %}
 description {{ iface.description }}
{% endif %}
{% if iface.ipv4_address %}
 ip address {{ iface.ipv4_address.ip }} {{ iface.ipv4_address.netmask }}
{% endif %}
{% if not iface.name.lower().startswith("loopback") %}
{% if iface.enabled %}
 undo shutdown
{% else %}
 shutdown
{% endif %}
{% endif %}
{% endfor %}
