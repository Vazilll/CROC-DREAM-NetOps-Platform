{% if 'leaf-1' in hostname or 'leaf1' in hostname %}{% raw %}
acl name FABRIC-IN advance
 rule 10 permit icmp
 rule 20 permit tcp destination-port eq bgp
 rule 30 permit tcp source-port eq bgp
 rule 40 deny tcp destination-port eq telnet
 rule 50 permit ip
#
vlan 10
 description Tenant VLAN10 (host-a, host-b)
#
bridge-domain 10
 description Tenant VLAN10 -> VNI 10010
 vxlan vni 10010
 evpn
  route-distinguisher 10.255.0.1:10
  vpn-target 65000:10 both
#
{% endraw %}{% else %}{% raw %}
acl name FABRIC-IN advance
 rule 10 permit icmp
 rule 20 permit tcp destination-port eq bgp
 rule 30 permit tcp source-port eq bgp
 rule 40 deny tcp destination-port eq telnet
 rule 50 permit ip
#
vlan 10
 description Tenant VLAN10 (host-a, host-b)
#
bridge-domain 10
 description Tenant VLAN10 -> VNI 10010
 vxlan vni 10010
 evpn
  route-distinguisher 10.255.0.2:10
  vpn-target 65000:10 both
#
{% endraw %}{% endif %}
