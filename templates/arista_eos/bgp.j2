{% raw %}
router bgp 65000
   router-id 10.255.0.12
   no bgp default ipv4-unicast
   neighbor 10.10.0.5 remote-as 65001
   neighbor 10.10.0.5 description leaf1
   neighbor 10.10.0.5 send-community extended
   neighbor 10.10.0.7 remote-as 65002
   neighbor 10.10.0.7 description leaf2
   neighbor 10.10.0.7 send-community extended
   !
   address-family ipv4
      network 10.255.0.12/32
      neighbor 10.10.0.5 activate
      neighbor 10.10.0.7 activate
   !
   address-family evpn
      neighbor 10.10.0.5 activate
      neighbor 10.10.0.5 next-hop-unchanged
      neighbor 10.10.0.7 activate
      neighbor 10.10.0.7 next-hop-unchanged
!
{% endraw %}
